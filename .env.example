# ---------- INPUT / OUTPUT ----------
INPUT_XLSX=Assignment - Ai agent  - Sheet1.xlsx
OUTPUT_DIR=output
TEMP_DIR=temp

# ---------- IMAGE SEARCH ----------
# Create a free key at https://serper.dev
SERPER_API_KEY=YOUR_SERPER_API_KEY

# ---------- AI IMAGE EVALUATION (provisioned, not yet wired in) ----------
# Google AI Studio API key — kept here for the planned semantic
# image-match check; not currently used by the pipeline.
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# GEMINI_MODEL=gemini-2.5-flash

# ---------- GOOGLE DRIVE (OAuth) ----------
# Download your OAuth client secret from Google Cloud Console
# (APIs & Services > Credentials > OAuth client ID > Desktop app)
# and save it at the path below. The first run opens a browser
# window to authorize once; after that, token.json is reused.
GOOGLE_OAUTH_CLIENT_FILE=credentials/client_secret.json
GOOGLE_OAUTH_TOKEN_FILE=credentials/token.json
GOOGLE_DRIVE_FOLDER_ID=YOUR_DRIVE_FOLDER_ID
